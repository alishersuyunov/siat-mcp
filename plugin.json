{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "siat-mcp",
  "version": "0.3.1",
  "description": "13 read-only tools for Uzbekistan statistics: search and browse SIAT, inspect metadata, retrieve tables and multiple datasets, and explore NSDP indicators.",
  "author": {
    "name": "Alisher Suyunov"
  },
  "license": "MIT",
  "homepage": "https://github.com/alishersuyunov/siat-mcp",
  "repository": "https://github.com/alishersuyunov/siat-mcp",
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "interface": {
        "displayName": "Uzbekistan Statistics",
        "shortDescription": "Official Uzbekistan statistics",
        "category": "Data & Analytics",
        "websiteURL": "https://github.com/alishersuyunov/siat-mcp",
        "supportURL": "https://github.com/alishersuyunov/siat-mcp/issues"
      }
    }
  }
}
